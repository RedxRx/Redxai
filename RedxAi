    loadpos = function() return Cmd.loadpos() end,
    pos = function() return Cmd.pos() end,
    players = function() return Cmd.players() end,
    btools = function() return Cmd.btools() end,
    serverhop = function() return Cmd.serverhop() end,
    rejoin = function() return Cmd.rejoin() end,
    chat = function(a) return Cmd.chat(a) end,
}

local function ApplyTags(txt)
    local res = {}
    local clean = txt:gsub("%s*%[%[(%a+):?([^%]]*)%]%]", function(name, arg)
        local fn = Tags[name:lower()]
        if fn then
            local ok, r = pcall(fn, trim(arg))
            if ok and r then res[#res + 1] = r end
        end
        return ""
    end)
    clean = trim(clean)
    if #res > 0 then
        clean = (clean ~= "" and (clean .. "\n\n") or "") .. table.concat(res, "\n")
    end
    return clean
end--[[ RedxAI v27 | Part 3 of 3 | UI & Run ]]

