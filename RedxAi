end

local function espAdd(plr)
    if plr == LP then return end
    local function put(char)
        if not State.ESP or not char then return end
        local old = char:FindFirstChild("RedxESP")
        if old then old:Destroy() end
        local h = Instance.new("Highlight")
        h.Name = "RedxESP"
        h.FillColor = Color3.fromRGB(255, 0, 0)
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.Parent = char
        ESPObjects[#ESPObjects + 1] = h
    end
    put(plr.Character)
    setConn("esp_" .. tostring(plr.UserId), plr.CharacterAdded:Connect(function(c) task.wait(0.5) put(c) end))
end

function Cmd.esp(on)
    State.ESP = on
    for k in pairs(Conns) do
        if tostring(k):sub(1, 4) == "esp_" then dropConn(k) end
    end
    for _, o in ipairs(ESPObjects) do pcall(function() o:Destroy() end) end
    ESPObjects = {}
    if not on then return "ESP OFF" end
    for _, p in ipairs(Players:GetPlayers()) do espAdd(p) end
    setConn("esp_join", Players.PlayerAdded:Connect(function(p) espAdd(p) end))
    return "ESP ON"
end

function Cmd.fullbright(on)
    if on == false then
        for k, v in pairs(origLight) do pcall(function() Lighting[k] = v end) end
        return "Fullbright OFF"
    end
    Lighting.Brightness = 2
    Lighting.ClockTime = 12
    Lighting.FogEnd = 100000
    Lighting.GlobalShadows = false
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    return "Fullbright ON"
end

