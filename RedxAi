function Cmd.invisible(on)
    State.Invisible = on
    dropConn("invis")
    local function apply(v)
        local c = LP.Character if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.LocalTransparencyModifier = v
            elseif p:IsA("Decal") then p.Transparency = v end
        end
    end
    if on then apply(1); setConn("invis", RS.RenderStepped:Connect(function() apply(1) end)); return "Invisible ON" end
    apply(0); return "Visible"
end

