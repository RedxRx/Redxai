local function ParseDirectCommands(txt)
    if State.Mode ~= 1 then return nil end
    local t = norm(txt)
    local toks = tokenize(t)
    local _, nWords = t:gsub("%S+", "")
    if #toks == 0 or nWords > 6 then return nil end
    if isQuestion(txt, t, toks) then return nil end
    local num = tonumber(t:match("%d+%.?%d*"))
    local isOff = anyWord(t, toks, OFFWORDS)

    if isOff and anyWord(t, toks, VIEWWORDS) then return Cmd.view("") end

    for _, nc in ipairs(NameCmds) do
        for _, kw in ipairs(nc.kw) do
            local rest = afterKeyword(t, kw)
            if rest and rest ~= "" then
                local p = findPlayer(rest)
                if p then return nc.run(p.Name) end
            end
        end
    end

    for _, f in ipairs(Features) do
        if anyWord(t, toks, f.kw) then
            if isOff and f.off then return f.off(num, t) end
            return f.on(num, t)
        end
    end
    return nil
end

