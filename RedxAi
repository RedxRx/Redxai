function Maps.hasKW(s, list)
    if not s or not list then return false end
    local low = tostring(s):lower()
    for _, kw in ipairs(list) do if low:find(kw, 1, true) then return true end end
    return false
end

function Maps.int(x)
    x = tonumber(x) or 0
    if x ~= x or x > 1e9 or x < -1e9 then return 0 end
    return math.floor(x)
end

function Maps.posOf(v)
    if v:IsA("BasePart") then return v.Position end
    if v:IsA("Model") then
        local ok, cf = pcall(function() return v:GetPivot() end)
        if ok then return cf.Position end
    end
    return nil
end

function Maps.GameName()
    if Maps._name and Maps._placeId == game.PlaceId then return Maps._name end
    local n, d = "Unknown", ""
    pcall(function()
        local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
        n, d = info.Name, info.Description or ""
    end)
    if n ~= "Unknown" then
        Maps._name, Maps._desc, Maps._placeId = n, d, game.PlaceId
        Maps._scan = nil
    end
    return n
end

function Maps.itemInfo(btn, buyset, sg)
    local holder = btn.Parent
    local label, stock
    for _ = 1, 4 do
        if not holder or holder == sg then break end
        local nb = 0
        for _, d in ipairs(holder:GetDescendants()) do if buyset[d] then nb = nb + 1 end end
        if nb > 1 then break end
        for _, c in ipairs(holder:GetDescendants()) do
            if c:IsA("TextLabel") and c.Text ~= "" and #c.Text < 40 then
                local tx = c.Text
                if tx:lower():find("stock", 1, true) or tx:match("^[xX]%d+") then
                    stock = stock or tx
                elseif not tx:match("^[%d%p%s]+$") and not label and not Maps.hasKW(tx, Maps.buyKW) then
                    label = tx
                end
            end
        end
        if label then break end
        holder = holder.Parent
    end
    return label, stock
end
