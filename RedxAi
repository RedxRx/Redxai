local function dropConn(name)
    local c = Conns[name]
    if c then pcall(function() c:Disconnect() end) Conns[name] = nil end
end
local function setConn(name, c) dropConn(name) Conns[name] = c end
local function trim(s) return (tostring(s or ""):match("^%s*(.-)%s*$")) end
local function getHum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function getReq() return (syn and syn.request) or (http and http.request) or http_request or request end

local function findPlayer(q)
    q = trim(q):lower()
    if q == "" then return nil end
    local list = Players:GetPlayers()
    for _, p in ipairs(list) do
        if p ~= LP and (p.Name:lower() == q or p.DisplayName:lower() == q) then return p end
    end
    for _, p in ipairs(list) do
        if p ~= LP and (p.Name:lower():sub(1, #q) == q or p.DisplayName:lower():sub(1, #q) == q) then return p end
    end
    for _, p in ipairs(list) do
        if p ~= LP and (p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true)) then return p end
    end
    return nil
end

local controlModule, controlTried = nil, false
local function getMoveVector()
    if not controlModule and not controlTried then
        controlTried = true
        pcall(function()
            local ps = LP:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            local cm = pm and pm:FindFirstChild("ControlModule")
            if cm then controlModule = require(cm) end
        end)
    end
    if controlModule then
        local ok, v = pcall(function() return controlModule:GetMoveVector() end)
        if ok and typeof(v) == "Vector3" then return v end
    end
    local x, z = 0, 0
    if UIS:IsKeyDown(Enum.KeyCode.W) then z = z - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.S) then z = z + 1 end
    if UIS:IsKeyDown(Enum.KeyCode.A) then x = x - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.D) then x = x + 1 end
    return Vector3.new(x, 0, z)
end

function Cmd.fly(on, speed)
    if speed then State.FlySpeed = math.clamp(tonumber(speed) or 60, 1, 100000) end
    State.Fly = on and true or false
    dropConn("fly")
    if FlyBV then FlyBV:Destroy() FlyBV = nil end
    if FlyBG then FlyBG:Destroy() FlyBG = nil end
    local h, r = getHum(), getRoot()
    if not State.Fly then
        if h then h.PlatformStand = false end
        return "Fly OFF"
    end
    if not h or not r then State.Fly = false return "No character" end
    h.PlatformStand = true
    FlyBV = Instance.new("BodyVelocity")
    FlyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    FlyBV.Velocity = Vector3.new(0, 0, 0)
    FlyBV.Parent = r
    FlyBG = Instance.new("BodyGyro")
    FlyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    FlyBG.P = 1e4
    FlyBG.Parent = r
    setConn("fly", RS.RenderStepped:Connect(function()
        local root = getRoot()
        if not State.Fly or not root or not FlyBV or not FlyBV.Parent then return end
        local cam = workspace.CurrentCamera
        local mv = getMoveVector()
        local fwd = cam.CFrame.LookVector
        local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
        if right.Magnitude > 0 then right = right.Unit end
        local dir = (fwd * -mv.Z) + (right * mv.X)
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        if dir.Magnitude > 1 then dir = dir.Unit end
        FlyBV.Velocity = dir * State.FlySpeed
        FlyBG.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(fwd.X, 0, fwd.Z))
    end))
    return "Fly ON (Speed: " .. State.FlySpeed .. ")"
end

function Cmd.speed(v)
    State.Speed = math.clamp(tonumber(v) or 16, 1, 100000)
    local h = getHum() if h then h.WalkSpeed = State.Speed end
    return "Speed: " .. State.Speed
end
function Cmd.speedoff()
    State.Speed = nil
    local h = getHum() if h then h.WalkSpeed = 16 end
    return "Speed: normal (16)"
end

function Cmd.jump(v)
    if v == "inf" or v == "infinite" then
        State.InfJump = true
        setConn("infjump", UIS.JumpRequest:Connect(function()
            local h = getHum() if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end))
        return "Infinite Jump ON"
    end
    State.Jump = math.clamp(tonumber(v) or 50, 1, 100000)
    local h = getHum() if h then h.UseJumpPower = true h.JumpPower = State.Jump end
    return "Jump: " .. State.Jump
end
function Cmd.jumpoff()
    State.Jump = nil State.InfJump = false dropConn("infjump")
    local h = getHum() if h then h.UseJumpPower = true h.JumpPower = 50 end
    return "Jump: normal"
end

function Cmd.noclip(on)
    State.Noclip = on
    dropConn("noclip")
    if on then
        setConn("noclip", RS.Stepped:Connect(function()
            local c = LP.Character
            if not c then return end
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end))
        return "Noclip ON"
    end
    local c = LP.Character
    if c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = true end
        end
    end
    return "Noclip OFF"
end

function Cmd.god(on)
    State.God = on
    local h = getHum()
    if h then
        if on then h.MaxHealth = math.huge h.Health = math.huge
        else h.MaxHealth = 100 h.Health = 100 end
    end
    return on and "God ON" or "God OFF"
end

function Cmd.invisible(on)
    State.Invisible = on
    dropConn("invis")
    local function apply(v)
        local c = LP.Character if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.LocalTransparencyModifier = v
            elseif p:IsA("Decal") then p.Transparency = v end
        end
    end
    if on then
        apply(1)
        setConn("invis", RS.RenderStepped:Connect(function() apply(1) end))
        return "Invisible ON"
    end
    apply(0)
    return "Visible"
end

function Cmd.spin(on, speed)
    State.Spin = on
    dropConn("spin")
    if on then
        local s = math.clamp(tonumber(speed) or 10, 1, 360)
        setConn("spin", RS.Heartbeat:Connect(function()
            local r = getRoot()
            if r then r.CFrame = r.CFrame * CFrame.Angles(0, math.rad(s), 0) end
        end))
        return "Spin ON"
    end
    return "Spin OFF"
end

function Cmd.clicktp(on)
    State.ClickTP = on
    dropConn("ctp1") dropConn("ctp2")
    if not on then return "Click-TP OFF" end
    local function go(pos, viewport)
        local cam = workspace.CurrentCamera local r = getRoot()
        if not cam or not r then return end
        local ray = viewport and cam:ViewportPointToRay(pos.X, pos.Y) or cam:ScreenPointToRay(pos.X, pos.Y)
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {LP.Character}
        params.FilterType = Enum.RaycastFilterType.Exclude
        local hit = workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
        if hit then r.CFrame = CFrame.new(hit.Position + Vector3.new(0, 4, 0)) end
    end
    setConn("ctp1", UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            go(UIS:GetMouseLocation(), true)
        end
    end))
    setConn("ctp2", UIS.TouchTapInWorld:Connect(function(pos, processed)
        if not processed then go(pos, false) end
    end))
    return "Click-TP ON"
end

