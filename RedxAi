function Maps.Report(gname, stats, st, err, mismatch)
    local L = {"Map: " .. tostring(gname)}
    L[#L + 1] = "Scan: " .. stats.tools .. " tools | " .. stats.npcs .. " npc | " .. stats.zones .. " zone | " .. stats.shops .. " shop | " .. stats.farmables .. " farmable | " .. stats.roles .. " role | " .. stats.remotes .. " remote | " .. stats.prompts .. " prompt"
    if stats.tools + stats.remotes + stats.prompts + stats.clicks + stats.npcs + stats.zones + stats.shops + stats.farmables == 0 then
        L[#L + 1] = "Nothing useful found. Wait for game to load or /refresh."
    end
    if stats.shops == 0 and stats.farmables > 0 then L[#L + 1] = "Farming map. Ask for 'plant/harvest' or 'collect coins'." end
    if stats.npcs == 0 and stats.roles > 0 then L[#L + 1] = "Roles map. Ask 'who is murderer'." end
    if mismatch then L[#L + 1] = "Different map? /refresh" end
    if st == "ok" then L[#L + 1] = "Syntax OK."
    elseif st == "syntax" then L[#L + 1] = "Syntax error: " .. (tostring(err):gsub("[\r\n]+", " "))
    else L[#L + 1] = "Not code. Explain more." end
    return table.concat(L, "\n") .. "\n----------"
end

