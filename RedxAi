function Cmd.tp(name)
    local target = Players:FindFirstChild(name)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local r = getRoot()
        if r then r.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3) return "📍 Teleported to " .. name end
    end
    return "❌ Player not found"
end

function Cmd.bring(name)
    local target = Players:FindFirstChild(name)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local r = getRoot()
        if r then target.Character.HumanoidRootPart.CFrame = r.CFrame * CFrame.new(0, 0, -3) return "📍 Brought " .. name end
    end
    return "❌ Player not found"
end

