local function AskAI(text)
    local sys = ""
    if State.Mode == 3 then
        sys = [=[
            You are RedxAI, a Lua Script Generator for Delta Executor.
            Output ONLY the raw Lua code. No text, no markdown (```).
            Start directly with code.
        ]=]
    elseif State.Mode == 2 then
        sys = [=[
            You are RedxAI CodeMaster, an elite Roblox Lua developer.
            Converse normally, explain, or fix scripts. Ask for details if vague.
            Use markdown for code blocks.
        ]=]
    else
        sys = [=[
            You are RedxAI, a super intelligent AI inside Roblox.
            Answer in user's language. If user wants action, append tag at very end.
            Commands: [[fly:SPEED]] [[fly:off]] [[speed:NUM]] [[jump:NUM]] [[jump:inf]] [[noclip:on]] [[noclip:off]] [[god:on]] [[god:off]] [[invisible:on]] [[invisible:off]] [[kill:NAME]] [[fling:NAME]] [[freeze:NAME]] [[sit]] [[reset]] [[tp:NAME]] [[bring:NAME]] [[savepos]] [[loadpos]] [[fullbright]] [[esp:on]] [[esp:off]] [[gravity:NUM]] [[btools]] [[serverhop]] [[chat:MSG]]
        ]=]
    end
    local msgs = {{role = "system", content = sys}, {role = "user", content = text}}
    local ok, body = pcall(function() return HS:JSONEncode({model = "openai", messages = msgs}) end)
    if not ok then return nil end
    local fn = (syn and syn.request) or (http and http.request) or http_request or request
    if not fn then return nil end
    local ok1, res = pcall(fn, {Url = "https://text.pollinations.ai/openai", Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
    if ok1 and res and res.Body then
        local ok2, data = pcall(function() return HS:JSONDecode(res.Body) end)
        if ok2 and data.choices then return data.choices[1].message.content end
    end
    return nil
end

