local function findPlayer(q)
    q = trim(q):lower() if q == "" then return nil end
    local list = Players:GetPlayers()
    for _, p in ipairs(list) do if p ~= LP and (p.Name:lower() == q or p.DisplayName:lower() == q) then return p end end
    for _, p in ipairs(list) do if p ~= LP and (p.Name:lower():sub(1, #q) == q or p.DisplayName:lower():sub(1, #q) == q) then return p end end
    for _, p in ipairs(list) do if p ~= LP and (p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true)) then return p end end
    return nil
end

local controlModule = nil
local controlTried = false
local function getMoveVector()
    if not controlModule and not controlTried then
        controlTried = true
        pcall(function()
            local ps = LP:FindFirstChild("PlayerScripts") local pm = ps and ps:FindFirstChild("PlayerModule") local cm = pm and pm:FindFirstChild("ControlModule")
            if cm then controlModule = require(cm) end
        end)
    end
    if controlModule then local ok, v = pcall(function() return controlModule:GetMoveVector() end) if ok and typeof(v) == "Vector3" then return v end end
    local x, z = 0, 0
    if UIS:IsKeyDown(Enum.KeyCode.W) then z = z - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.S) then z = z + 1 end
    if UIS:IsKeyDown(Enum.KeyCode.A) then x = x - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.D) then x = x + 1 end
    return Vector3.new(x, 0, z)
end

function Cmd.fly(on, speed)
    if speed then State.FlySpeed = math.clamp(tonumber(speed) or 60, 1, 100000) end
    State.Fly = on and true or false
    dropConn("fly") if FlyBV then FlyBV:Destroy() FlyBV = nil end if FlyBG then FlyBG:Destroy() FlyBG = nil end
    local h, r = getHum(), getRoot()
    if not State.Fly then if h then h.PlatformStand = false end UpdateControlPanel() return "🛑 Fly OFF" end
    if not h or not r then State.Fly = false UpdateControlPanel() return "❌ No character" end
    h.PlatformStand = true
    FlyBV = Instance.new("BodyVelocity") FlyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5) FlyBV.Velocity = Vector3.new(0, 0, 0) FlyBV.Parent = r
    FlyBG = Instance.new("BodyGyro") FlyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5) FlyBG.P = 1e4 FlyBG.Parent = r
    setConn("fly", RS.RenderStepped:Connect(function()
        local root = getRoot() if not State.Fly or not root or not FlyBV or not FlyBV.Parent then return end
        local cam = workspace.CurrentCamera local mv = getMoveVector() local fwd = cam.CFrame.LookVector
        local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z) if right.Magnitude > 0 then right = right.Unit end
        local dir = (fwd * -mv.Z) + (right * mv.X)
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        if dir.Magnitude > 1 then dir = dir.Unit end
        FlyBV.Velocity = dir * State.FlySpeed
        FlyBG.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(fwd.X, 0, fwd.Z))
    end))
    UpdateControlPanel()
    return "✈ Fly ON (Speed: " .. State.FlySpeed .. ")"
end

