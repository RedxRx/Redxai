function Maps.GameName()
    if Maps._name and Maps._placeId == game.PlaceId then return Maps._name end
    local n, d = "Unknown", ""
    pcall(function()
        local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
        n, d = info.Name, info.Description or ""
    end)
    if n ~= "Unknown" then
        Maps._name, Maps._desc, Maps._placeId = n, d, game.PlaceId
        Maps._scan = nil
    end
    return n
end

function Maps.Scan()
    if Maps._scan and os.clock() - Maps._scanT < 60 then return Maps._scan, Maps._stats, Maps.GameName() end
    local out = {}
    local function add(s) out[#out + 1] = s end
    local stats = {tools=0,remotes=0,prompts=0,clicks=0,touch=0,npcs=0,zones=0,shops=0,farmables=0,roles=0}
    local gname = Maps.GameName()
    add("Game: " .. gname .. " | PlaceId: " .. tostring(game.PlaceId) .. " | Players: " .. #Players:GetPlayers())
    local desc = tostring(Maps._desc or ""):gsub("%s+", " ")
    if desc ~= "" and desc ~= " " then add("Description: " .. desc:sub(1, 250)) end
    add("Executor functions: " .. table.concat({"fireproximityprompt","firetouchinterest","fireclickdetector","firesignal","getconnections","setclipboard","request","gethui","queue_on_teleport","Drawing"}, ", "))
    
    local myPos pcall(function() local r = getRoot() if r then myPos = r.Position end end)
    if myPos then add("Player position: (" .. Maps.int(myPos.X) .. "," .. Maps.int(myPos.Y) .. "," .. Maps.int(myPos.Z) .. ")") end

    local tools, toolSeen, remotes = {}, {}, {}
    local prompts, promptSeen = {}, {}
    local scanned = 0

    local function scanRoot(root, label)
        local okL, list = pcall(function() return root:GetDescendants() end)
        if not okL then return end
        for _, v in ipairs(list) do
            scanned = scanned + 1
            if scanned % 2500 == 0 then task.wait() end
            local cls = v.ClassName
            if cls == "Tool" then
                stats.tools = stats.tools + 1
                if not toolSeen[v.Name] and #tools < 40 then toolSeen[v.Name] = true tools[#tools + 1] = v.Name .. "@" .. label end
            elseif cls == "RemoteEvent" or cls == "RemoteFunction" then
                stats.remotes = stats.remotes + 1
                if #remotes < 400 then
                    local path = v:GetFullName():gsub("^[%w_]+%.", "")
                    remotes[#remotes + 1] = {kind = (cls == "RemoteEvent") and "E:" or "F:", path = path, hit = Maps.hasKW(v.Name, Maps.remoteKW) or Maps.hasKW(path, Maps.remoteKW)}
                end
            elseif cls == "ProximityPrompt" then
                stats.prompts = stats.prompts + 1
                local pname = v.Parent and v.Parent.Name or "?"
                local key = pname .. "|" .. v.ActionText
                if not promptSeen[key] and #prompts < 25 then promptSeen[key] = true prompts[#prompts + 1] = pname .. "[" .. v.ActionText .. "]" end
            end
        end
    end

    scanRoot(workspace, "Workspace")
    scanRoot(game:GetService("ReplicatedStorage"), "ReplicatedStorage")
    scanRoot(game:GetService("StarterPack"), "StarterPack")
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then scanRoot(bp, "Backpack") end

    if #tools > 0 then add("Tools (" .. stats.tools .. "): " .. table.concat(tools, ", ")) end
    if #remotes > 0 then
        local rt = {}
        for i = 1, math.min(#remotes, 40) do rt[i] = remotes[i].kind .. remotes[i].path end
        add("Remotes (" .. stats.remotes .. "): " .. table.concat(rt, ", "))
    end

    local s = table.concat(out, "\n")
    if #s > 7000 then s = s:sub(1, 7000) .. "..." end
    Maps._scan, Maps._stats, Maps._scanT = s, stats, os.clock()
    return s, stats, gname
end

function Maps.System(L)
