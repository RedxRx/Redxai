local function Submit()
    if State.Busy then return end
    local txt = trim(input.Text)
    if txt == "" then return end
    input.Text = ""
    addMsg(txt, true)
    State.Busy = true
    task.spawn(function()
        local thinking, activeBubble = false, nil
        local ok, err = pcall(function()
            local nt = norm(txt)
            if nt == "/clear" or nt == "clear" then
                History = {{},{},{},{}}
                Maps._scan = nil
                addMsg("Cleared history.", false)
                return
            end
            if nt == "/refresh" or nt == "refresh" or nt == "/scan" then
                Maps._scan = nil
                local _, stats, gname = Maps.Scan()
                addMsg(Maps.Report(gname, stats, "ok"), false)
                return
            end
            local mode = State.Mode
            if mode == 1 or mode == 4 then
                local direct = ParseDirectCommands(txt)
                if direct then addMsg(direct, false) return end
            end
            if mode == 4 then Maps._scan = nil end
            local bubble, container = addMsg("Thinking...", false)
            activeBubble = bubble
            thinking = true
            task.spawn(function()
                local n = 0
                while thinking do
                    n = n % 3 + 1
                    if bubble and bubble.Parent then bubble.Text = "Thinking" .. string.rep(".", n) end
                    task.wait(0.4)
                end
            end)
            local ans, why = AskAI(txt, mode, false)
            if ans and (mode == 3 or mode == 4) and not looksLikeCode(stripFences(ans)) then
                ans = AskAI(txt, mode, true) or ans
            end
            thinking = false
            if not ans then
                if why == "no_http" then setBubbleText(bubble, "Executor does not support request.")
                else setBubbleText(bubble, "Server busy. Try again.") end
            else
                local clean = ans
                if mode == 3 or mode == 4 then
                    clean = stripFences(ans)
                    bubble.TextColor3 = Color3.fromRGB(150, 255, 150)
                elseif mode == 1 then
                    clean = ApplyTags(ans)
                end
                if clean == "" then clean = "Done" end
                pushHist(mode, txt, ans)
                setBubbleText(bubble, clean)
                attachCopy(container, clean)
            end
            scrollDown()
        end)
        thinking = false
        State.Busy = false
        if not ok then
            if activeBubble and activeBubble.Parent then setBubbleText(activeBubble, "Error: " .. tostring(err))
            else addMsg("Error: " .. tostring(err), false) end
        end
    end)
end

