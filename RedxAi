local CPMAP = {
    [0x0623] = 0x0627, [0x0625] = 0x0627, [0x0622] = 0x0627, [0x0671] = 0x0627,
    [0x0649] = 0x064A, [0x06CC] = 0x064A, [0x0629] = 0x0647, [0x06A9] = 0x0643,
    [0x060C] = 0x20, [0x061F] = 0x20, [0x061B] = 0x20,
}
local function norm(s)
    s = tostring(s or "")
    local ok, res = pcall(function()
        local out = {}
        for _, cp in utf8.codes(s) do
            if (cp >= 0x064B and cp <= 0x065F) or cp == 0x0640 then
            else
                if cp >= 0x0660 and cp <= 0x0669 then cp = cp - 0x0660 + 0x30 end
                out[#out + 1] = utf8.char(CPMAP[cp] or cp)
            end
        end
        return table.concat(out)
    end)
    return string.lower(ok and res or s)
end
local function K(...) local t = {} for _, w in ipairs({...}) do t[#t + 1] = norm(w) end return t end
local function tokenize(t)
    local toks = {}
    for w in t:gmatch("[^%s%p]+") do
        toks[#toks + 1] = w
        local f = w:sub(1, 2)
        if (f == "و" or f == "ب" or f == "ف") and #w > 4 then toks[#toks + 1] = w:sub(3) end
    end
    return toks
end
local function hasWord(t, toks, kw)
    if kw:find(" ", 1, true) then return (" " .. t):find(" " .. kw, 1, true) ~= nil end
    local isAscii = not kw:find("[\128-\255]")
    local n = #kw
    for _, w in ipairs(toks) do
        if w == kw then return true end
        if not isAscii then
            if w == "ال" .. kw then return true end
            if #w > n and w:sub(1, n) == kw and #w <= n + 6 then return true end
        end
    end
    return false
end
local function anyWord(t, toks, list) for _, kw in ipairs(list) do if hasWord(t, toks, kw) then return true end end return false end
local function afterKeyword(t, kw)
    local init = 1
    while true do
        local s, e = t:find(kw, init, true)
        if not s then return nil end
        if s == 1 or t:sub(s - 1, s - 1) == " " then return trim(t:sub(e + 1)) end
        init = e + 1
    end
end

local OFFWORDS = K("شيل","وقف","اوقف","ايقاف","اطفي","طفي","الغاء","الغي","بطل","اقفل","قفل","ازل","ازاله","امسح","off","stop","disable","remove","cancel","reset","ريسيت","unview")
local QUESTIONW = K("ازاي","ليه","لييه","يعني","ايه","هل","ماذا","كيف","لماذا","what","how","why","explain","اشرح","وضح","ينفع","معني")
local QEXACT = K("شو","وش")
local SCRIPTW = K("سكريبت","سكربت","اسكريبت","سكريبتات","script","scripts","كود","code")

local function isQuestion(raw, t, toks)
    if raw:find("?", 1, true) or raw:find("؟", 1, true) then return true end
    for _, w in ipairs(toks) do
        for _, q in ipairs(QEXACT) do if w == q then return true end end
    end
    return anyWord(t, toks, QUESTIONW)
end

