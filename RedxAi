function Cmd.jump(v) 
    if v == "inf" or v == "infinite" then 
        State.InfJump = true 
        setConn("infjump", UIS.JumpRequest:Connect(function() 
            local h = getHum() 
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end 
        end))
        return "Infinite Jump ON" 
    end
    State.Jump = math.clamp(tonumber(v) or 50, 1, 100000) 
    local h = getHum() 
    if h then h.UseJumpPower = true h.JumpPower = State.Jump end 
    if UpdatePanel then UpdatePanel() end
    return "Jump: " .. State.Jump 
end

function Cmd.jumpoff() 
    State.Jump = nil State.InfJump = false 
    dropConn("infjump") 
    local h = getHum() 
    if h then h.UseJumpPower = true h.JumpPower = 50 end 
    if UpdatePanel then UpdatePanel() end
    return "Jump: normal" 
end

function Cmd.noclip(on) 
    State.Noclip = on 
    dropConn("noclip") 
    if on then 
        setConn("noclip", RS.Stepped:Connect(function() 
            local c = LP.Character 
            if not c then return end 
            for _, p in ipairs(c:GetDescendants()) do 
                if p:IsA("BasePart") then p.CanCollide = false end 
            end 
        end))
    else 
        local c = LP.Character 
        if c then 
            for _, p in ipairs(c:GetDescendants()) do 
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = true end 
            end 
        end 
    end 
    if UpdatePanel then UpdatePanel() end
    return on and "Noclip ON" or "Noclip OFF" 
end

function Cmd.god(on) 
    State.God = on 
    local h = getHum() 
    if h then 
        if on then 
            h.MaxHealth = math.huge 
            h.Health = math.huge 
        else 
            h.MaxHealth = 100 
            h.Health = 100 
        end 
    end 
    return on and "God ON" or "God OFF" 
end

function Cmd.invisible(on) 
    State.Invisible = on 
    dropConn("invis") 
    local function apply(v) 
        local c = LP.Character 
        if not c then return end 
        for _, p in ipairs(c:GetDescendants()) do 
            if p:IsA("BasePart") then p.LocalTransparencyModifier = v 
            elseif p:IsA("Decal") then p.Transparency = v end 
        end 
    end
    if on then 
        apply(1) 
        setConn("invis", RS.RenderStepped:Connect(function() apply(1) end)) 
        return "Invisible ON" 
    end
    apply(0) 
    return "Visible" 
end

function Cmd.spin(on, speed) 
