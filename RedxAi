-- returns handled, reply
local function TryCommand(text, ar)
	local n = Clean(text)
	if n == "" then return false end
	local num = tonumber(n:match("%d+"))

	local isOff, isOn = HasAny(n, K.off), HasAny(n, K.on)
	local hasAct = isOff or isOn or HasAny(n, K.act) or num ~= nil
	local strongQ = false
	for _, kw in ipairs(K.qStrongExact) do if HasExact(n, kw) then strongQ = true end end
	if not strongQ then strongQ = HasAny(n, K.qStrongSub) end
	local weakQ = text:find("?", 1, true) ~= nil or text:find("؟", 1, true) ~= nil
	if not weakQ then
		for _, kw in ipairs(K.qWeakExact) do if HasExact(n, kw) then weakQ = true end end
	end
	if strongQ then return false end
	if weakQ and not hasAct then return false end

	local mFly, mSpeed, mJump = HasAny(n, K.fly), HasAny(n, K.speed), HasAny(n, K.jump)

	-- infinite jump
	if HasAny(n, K.inf) then
		Actions.SetInfJump(not isOff)
		return true, State.InfJump and T(ar, "♾ القفز اللانهائي شغال", "♾ Infinite jump ON") or T(ar, "تم إيقاف القفز اللانهائي", "Infinite jump OFF")
	end

	-- reset
	if HasAny(n, K.reset) then
		if mFly and not (mSpeed or mJump) then
			Actions.StopFly()
			return true, T(ar, "🛑 تم إيقاف الطيران", "🛑 Fly OFF")
		elseif mSpeed and not (mFly or mJump) then
			Actions.SetSpeed(nil)
			return true, T(ar, "⚡ السرعة رجعت طبيعية (16)", "⚡ Speed back to normal (16)")
		elseif mJump and not (mFly or mSpeed) then
			Actions.SetJump(nil)
			return true, T(ar, "⬆ القفز رجع طبيعي (50)", "⬆ Jump back to normal (50)")
		end
		Actions.ResetAll()
		return true, T(ar, "↺ رجّعت كل حاجة للوضع الطبيعي", "↺ Everything is back to normal")
	end

	-- fly
	if mFly then
		if num then State.FlySpeed = clamp(num, 5, 300) end
		local want
		if isOff then want = false elseif isOn or num then want = true else want = not State.Fly end
		if want then
			if Actions.StartFly() then
				return true, T(ar, "✈ الطيران شغال (السرعة " .. State.FlySpeed .. ") — حرّك الجويستيك، وأزرار ▲ ▼ للصعود والنزول",
					"✈ Fly ON (speed " .. State.FlySpeed .. ") — use the joystick, and the ▲ ▼ buttons to go up/down")
			end
			return true, T(ar, "مفيش شخصية دلوقتي، استنى لحد ما تظهر", "No character yet, wait until you spawn")
		end
		Actions.StopFly()
		return true, T(ar, "🛑 تم إيقاف الطيران", "🛑 Fly OFF")
	end

	-- speed
	if mSpeed then
		if isOff then
			Actions.SetSpeed(nil)
			return true, T(ar, "⚡ السرعة رجعت طبيعية (16)", "⚡ Speed back to normal (16)")
		end
		local v = clamp(num or CONFIG.DefaultSpeed, 0, 1000)
		Actions.SetSpeed(v)
		return true, T(ar, "⚡ السرعة دلوقتي " .. v, "⚡ Speed is now " .. v)
	end

	-- jump
	if mJump then
		if isOff then
			Actions.SetJump(nil)
			return true, T(ar, "⬆ القفز رجع طبيعي (50)", "⬆ Jump back to normal (50)")
		end
		local v = clamp(num or CONFIG.DefaultJump, 0, 1000)
		Actions.SetJump(v)
		return true, T(ar, "⬆ قوة القفز دلوقتي " .. v, "⬆ Jump power is now " .. v)
	end

	return false
end

