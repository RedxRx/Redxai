function Maps.hasKW(s, list)
    if not s or not list then return false end
    local low = tostring(s):lower()
    for _, kw in ipairs(list) do if low:find(kw, 1, true) then return true end end
    return false
end

function Maps.int(x)
    x = tonumber(x) or 0
    if x ~= x or x > 1e9 or x < -1e9 then return 0 end
    return math.floor(x)
end

function Maps.posOf(v)
    if v:IsA("BasePart") then return v.Position end
