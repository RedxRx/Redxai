---------------------------------------------------------------- AI (online)
local SYSTEM = "You are RedxAI, a smart and friendly assistant living inside a Roblox script. "
	.. "Always answer in the same language the user writes in (Arabic or English only). "
	.. "Answer ANY question helpfully and keep it short (max 5 sentences, no markdown). "
	.. "You can also control the player: when the user asks for one of these actions, add the matching tag at the very end of your reply: "
	.. "[[fly:on]] [[fly:off]] [[speed:NUMBER]] [[jump:NUMBER]] [[infjump:on]] [[infjump:off]] [[reset]]. Never use a tag otherwise."

local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request

local function Http(method, url, headers, body)
	if not httpRequest then return nil end
	local ok, res = pcall(httpRequest, { Url = url, Method = method, Headers = headers, Body = body })
	if not ok or type(res) ~= "table" then return nil end
	local code = res.StatusCode or res.status_code
	if code and (code < 200 or code >= 300) then return nil end
	return res.Body or res.body
end

local function ParseBody(body)
	if type(body) ~= "string" or body == "" then return nil end
	if body:sub(1, 1) == "{" then
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if ok and type(data) == "table" then
			local ch = data.choices and data.choices[1]
			local content = ch and ch.message and ch.message.content
			if type(content) == "string" and content ~= "" then return content end
			return nil
		end
	end
	return body
end

local History = {}
local function AskAI(text)
	local messages = { { role = "system", content = SYSTEM } }
	for _, m in ipairs(History) do messages[#messages + 1] = m end
	messages[#messages + 1] = { role = "user", content = text }
	local ans
	if CONFIG.ApiKey ~= "" then
		ans = ParseBody(Http("POST", CONFIG.ApiUrl,
			{ ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. CONFIG.ApiKey },
			HttpService:JSONEncode({ model = CONFIG.Model, messages = messages })))
	end
	if not ans then
		ans = ParseBody(Http("POST", "https://text.pollinations.ai/openai",
			{ ["Content-Type"] = "application/json" },
			HttpService:JSONEncode({ model = "openai", messages = messages })))
	end
	if not ans then
		local url = "https://text.pollinations.ai/" .. HttpService:UrlEncode(text:sub(1, 400))
			.. "?model=openai&system=" .. HttpService:UrlEncode(SYSTEM)
		ans = ParseBody(Http("GET", url, {}))
	end
	return ans
end

-- the AI may append action tags like [[fly:on]] — run them and hide them
local function ApplyTags(ans)
	local did = false
	for name, arg in ans:gmatch("%[%[%s*(%w+)%s*:?%s*([%w%.]*)%s*%]%]") do
		name, arg = name:lower(), arg:lower()
		if name == "fly" then
			if arg == "off" then Actions.StopFly() else Actions.StartFly() end
			did = true
		elseif name == "speed" then
			Actions.SetSpeed(clamp(tonumber(arg) or CONFIG.DefaultSpeed, 0, 1000)) did = true
		elseif name == "jump" then
			Actions.SetJump(clamp(tonumber(arg) or CONFIG.DefaultJump, 0, 1000)) did = true
		elseif name == "infjump" then
			Actions.SetInfJump(arg ~= "off") did = true
		elseif name == "reset" then
			Actions.ResetAll() did = true
		end
	end
	local clean = ans:gsub("%[%[.-%]%]", "")
	return (clean:match("^%s*(.-)%s*$")), did
end

