function Cmd.serverhop()
    local TS = game:GetService("TeleportService")
    local req = getReq()
    if req then
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local ok, res = pcall(req, {Url = url, Method = "GET"})
        if ok and res and res.Body then
            local ok2, data = pcall(function() return HS:JSONDecode(res.Body) end)
            if ok2 and data and data.data then
                for _, srv in ipairs(data.data) do
                    if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                        TS:TeleportToPlaceInstance(game.PlaceId, srv.id, LP)
                        return "Hopping..."
                    end
                end
            end
        end
    end
    return "No servers found"
end

function Cmd.rejoin()
    local TS = game:GetService("TeleportService")
    if #Players:GetPlayers() <= 1 then TS:Teleport(game.PlaceId, LP)
    else TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end
    return "Rejoining..."
end

function Cmd.chat(msg)
    msg = trim(msg)
    if msg == "" then return "Empty message" end
    local TCS = game:GetService("TextChatService")
    local okV, ver = pcall(function() return TCS.ChatVersion end)
    if okV and ver == Enum.ChatVersion.TextChatService then
        local chans = TCS:FindFirstChild("TextChannels")
        local ch = chans and chans:FindFirstChild("RBXGeneral")
        if ch then ch:SendAsync(msg) return "Sent: " .. msg end
    end
    local event = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    local say = event and event:FindFirstChild("SayMessageRequest")
    if say then say:FireServer(msg, "All") return "Sent: " .. msg end
    return "Chat not available"
end

