---------------------------------------------------------------- HTTP + AI
local function httpPost(url, body)
    local fn = (syn and syn.request) or (http and http.request) or http_request or request
    if not fn then return nil end
    local ok, res = pcall(fn, {
        Url = url, Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body
    })
    if ok and type(res) == "table" then return res.Body or res.body end
    return nil
end

local History = {}
local function AskAI(text)
    local sys = "You are RedxAI, a Roblox assistant. "
        .. "Answer in the same language as the user (Arabic or English only). Max 4 short sentences, no markdown. "
        .. "You can control the player. When the user asks for an action, add at the very end: "
        .. "[[fly:on]] [[fly:off]] [[fly:NUMBER]] [[speed:NUMBER]] [[jump:NUMBER]] "
        .. "[[infjump:on]] [[infjump:off]] [[noclip:on]] [[noclip:off]] [[esp:on]] [[esp:off]] [[reset]]. "
        .. "If the user asks for something not in this list, explain what it means and try to help."
    local msgs = { { role = "system", content = sys } }
    for _, m in ipairs(History) do msgs[#msgs+1] = m end
    msgs[#msgs+1] = { role = "user", content = text }
    local ok, body = pcall(function()
        return HS:JSONEncode({ model = "openai", messages = msgs })
    end)
    if not ok then return nil end
    local res = httpPost(CONFIG.AI_Url, body)
    if not res then return nil end
    local ok2, data = pcall(function() return HS:JSONDecode(res) end)
    if ok2 and type(data) == "table" and data.choices and data.choices[1] then
        local m = data.choices[1].message
        if m and m.content then return m.content end
    end
    return nil
end

local function ApplyTags(txt)
    local did = false
    for name, arg in txt:gmatch("%[%[(%w+):?([%w%.]*)%]%]") do
        name = string.lower(name); arg = string.lower(arg)
        if name == "fly" then
            if arg == "off" then StopFly() else
                local n = tonumber(arg)
                if n then State.FlySpeed = clamp(n, CONFIG.MinFlySpeed, CONFIG.MaxFlySpeed) end
                if not State.Fly then StartFly() end
            end
            did = true
        elseif name == "speed" then
            SetSpeed(clamp(tonumber(arg) or CONFIG.DefaultSpeed, CONFIG.MinSpeed, CONFIG.MaxSpeed))
            did = true
        elseif name == "jump" then
            SetJump(clamp(tonumber(arg) or CONFIG.DefaultJump, CONFIG.MinJump, CONFIG.MaxJump))
            did = true
        elseif name == "infjump" then
            SetInfJump(arg ~= "off") did = true
        elseif name == "noclip" then
            SetNoclip(arg ~= "off") did = true
        elseif name == "esp" then
            SetESP(arg ~= "off") did = true
        elseif name == "reset" then
            ResetAll() did = true
        end
    end
    local clean = txt:gsub("%[%[.-%]%]", "")
    return (clean:match("^%s*(.-)%s*$")), did
end

---------------------------------------------------------------- LOCAL COMMAND PARSER
local function Norm(s)
    s = tostring(s or "")
    s = s:lower()
    s = s:gsub("[أإآ]", "ا")
    s = s:gsub("ة", "ه")
    s = s:gsub("ى", "ي")
    s = s:gsub("ؤ", "و")
    s = s:gsub("ئ", "ي")
    return s
end

local function TryCmd(text)
    local n = Norm(text)
    local num = tonumber(n:match("%d+"))

    -- fly
    if n:find("طيران") or n:find("طير") or n:find("fly") then
        if n:find("وقف") or n:find("stop") or n:find("off") then
            StopFly(); return T("flyOff")
        end
        if State.Fly then StopFly() return T("flyOff") end
        if num then State.FlySpeed = clamp(num, CONFIG.MinFlySpeed, CONFIG.MaxFlySpeed) end
        if StartFly() then return T("flyOn") .. " (speed " .. State.FlySpeed .. ")" end
        return T("noChar")
    end

    -- speed
    if n:find("سرع") or n:find("speed") or n:find("اسرع") or n:find("faster") then
        if n:find("وقف") or n:find("off") or n:find("reset") then
            SetSpeed(nil); return T("speedSet") .. "16"
        end
        local v = clamp(num or CONFIG.DefaultSpeed, CONFIG.MinSpeed, CONFIG.MaxSpeed)
        SetSpeed(v); return T("speedSet") .. v
    end

    -- jump
    if n:find("قفز") or n:find("jump") or n:find("نط") then
        if n:find("وقف") or n:find("off") or n:find("reset") then
            SetJump(nil); return T("jumpSet") .. "50"
        end
        local v = clamp(num or CONFIG.DefaultJump, CONFIG.MinJump, CONFIG.MaxJump)
        SetJump(v); return T("jumpSet") .. v
    end

    -- inf jump
    if n:find("لا نهائي") or n:find("لانهائي") or n:find("مستمر") or n:find("infinite") or n:find("inf jump") or n:find("infjump") then
        SetInfJump(not State.InfJump)
        return State.InfJump and T("infJumpOn") or T("infJumpOff")
    end

    -- noclip
    if n:find("noclip") or n:find("نو كليب") or n:find("اختراق الجدران") then
        SetNoclip(not State.Noclip)
        return State.Noclip and T("noclipOn") or T("noclipOff")
    end

    -- esp
    if n:find("esp") or n:find("وال هاك") or n:find("wallhack") then
        SetESP(not State.ESP)
        return State.ESP and T("espOn") or T("espOff")
    end

    -- teleport
    if n:find("teleport") or n:find("تيليبورت") or n:find("تنقل") then
        if num then
            -- teleport to 0, num, 0 (demo)
            if TeleportTo(Vector3.new(0, num, 0)) then return T("teleported") end
        end
        return T("noChar")
    end

    -- reset
    if n:find("reset") or n:find("ريسيت") or n:find("رجع") then
        ResetAll(); return T("resetDone")
    end

    return nil
end

