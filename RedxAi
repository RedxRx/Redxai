    "ازل", "ازاله", "امسح", "off", "stop", "disable", "remove", "cancel", "reset", "ريسيت", "unview")
local QUESTIONW = K("ازاي", "ليه", "لييه", "يعني", "ايه", "هل", "ماذا", "كيف", "لماذا", "what", "how", "why",
    "explain", "اشرح", "وضح", "ينفع", "معني")
local QEXACT = K("شو", "وش")

local function isQuestion(raw, t, toks)
    if raw:find("?", 1, true) or raw:find("؟", 1, true) then return true end
    for _, w in ipairs(toks) do
        for _, q in ipairs(QEXACT) do
            if w == q then return true end
        end
    end
    return anyWord(t, toks, QUESTIONW)
end

