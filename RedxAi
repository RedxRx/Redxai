---------------------------------------------------------------- CONTROL MODULE (lazy)
local controlModule, controlTried = nil, false
local function ensureControls()
    if controlTried then return controlModule end
    controlTried = true
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        local pm = ps and ps:FindFirstChild("PlayerModule")
        local cm = pm and pm:FindFirstChild("ControlModule")
        if cm then controlModule = require(cm) end
    end)
    return controlModule
end

local function getMoveInput()
    local cm = ensureControls()
    if cm then
        local ok, mv = pcall(function() return cm:GetMoveVector() end)
        if ok and typeof(mv) == "Vector3" then return mv.X, mv.Z end
    end
    local x, z = 0, 0
    if UIS:IsKeyDown(Enum.KeyCode.W) then z = z + 1 end
    if UIS:IsKeyDown(Enum.KeyCode.S) then z = z - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.A) then x = x - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.D) then x = x + 1 end
    return x, z
end

---------------------------------------------------------------- FLY
local flyBV, flyBG, flyConn

local function StopFly()
    State.Fly = false
    State.FlyVert = 0
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    local h = getHum()
    if h then h.PlatformStand = false end
end

local function StartFly()
    local h, r = getHum(), getRoot()
    if not h or not r then return false end
    StopFly()
    State.Fly = true
    h.PlatformStand = true
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e5,1e5,1e5)
    flyBV.Parent = r
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e5,1e5,1e5)
    flyBG.P = 1e4
    flyBG.Parent = r
    flyConn = RS.RenderStepped:Connect(function()
        if not State.Fly then return end
        local r, cam = getRoot(), workspace.CurrentCamera
        if not r or not cam or not flyBV or not flyBG then StopFly() return end
        h = getHum()
        if h then h.PlatformStand = true end

        local rx, fz = getMoveInput()
        local cf = cam.CFrame

        -- forward includes Y (look up = go up)
        local fwd = cf.LookVector
        -- right is horizontal only
        local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
        if right.Magnitude > 0.01 then right = right.Unit end

        local dir = fwd * fz + right * rx

        -- vertical buttons
        local v = State.FlyVert
        if UIS:IsKeyDown(Enum.KeyCode.Space) then v = v + 1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v = v - 1 end
        dir = dir + Vector3.new(0, v, 0)

        if dir.Magnitude > 1 then dir = dir.Unit end
        flyBV.Velocity = dir * State.FlySpeed

        local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        if flat.Magnitude > 0.01 then
            flyBG.CFrame = CFrame.new(r.Position, r.Position + flat)
        end
    end)
    return true
end

---------------------------------------------------------------- SPEED / JUMP
local function SetSpeed(v)
    State.Speed = v
    local h = getHum()
    if h then h.WalkSpeed = v or 16 end
end
local function SetJump(v)
    State.Jump = v
    local h = getHum()
    if h then h.UseJumpPower = true h.JumpPower = v or 50 end
end

---------------------------------------------------------------- INF JUMP
local infJumpConn
local function SetInfJump(on)
    State.InfJump = on and true or false
    if infJumpConn then infJumpConn:Disconnect() infJumpConn = nil end
    if State.InfJump then
        infJumpConn = UIS.JumpRequest:Connect(function()
            local h = getHum()
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    end
end

---------------------------------------------------------------- NOCLIP
local noclipConn
local function SetNoclip(on)
    State.Noclip = on and true or false
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    if State.Noclip then
        noclipConn = RS.Stepped:Connect(function()
            local c = LP.Character
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)
    else
        local c = LP.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.CanCollide = true
                end
            end
        end
    end
end

---------------------------------------------------------------- ESP
local espConns = {}
local function ClearESP()
    for plr, hl in pairs(espConns) do
        if hl and hl.Parent then hl:Destroy() end
        espConns[plr] = nil
    end
end
local function SetESP(on)
    State.ESP = on and true or false
    if not State.ESP then ClearESP() return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            if not plr.Character:FindFirstChild("RedxESP") then
                local hl = Instance.new("Highlight")
                hl.Name = "RedxESP"
                hl.FillColor = Color3.fromRGB(255, 50, 50)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.Parent = plr.Character
                espConns[plr] = hl
            end
        end
    end
end
