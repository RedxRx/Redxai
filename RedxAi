function Cmd.kill(name)
    local plr = findPlayer(name)
    if plr and plr.Character then
        local h = plr.Character:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 return "Killed " .. plr.Name end
    end
    return "Player not found"
end

function Cmd.fling(name)
    local plr = findPlayer(name)
    local root = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if root then
        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.new(500, 500, 500)
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Parent = root
        task.delay(2, function() bv:Destroy() end)
        return "Flung " .. plr.Name
    end
    return "Player not found"
end

function Cmd.freeze(name)
    local plr = findPlayer(name)
    local root = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if root then
        root.Anchored = not root.Anchored
        return (root.Anchored and "Froze " or "Unfroze ") .. plr.Name
    end
    return "Player not found"
end

function Cmd.tp(name)
    local target = findPlayer(name)
    local tr = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    local r = getRoot()
    if tr and r then
        r.CFrame = tr.CFrame * CFrame.new(0, 0, 3)
        return "Teleported to " .. target.Name
    end
    return "Player not found"
end

function Cmd.bring(name)
    local target = findPlayer(name)
    local tr = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    local r = getRoot()
    if tr and r then
        tr.CFrame = r.CFrame * CFrame.new(0, 0, -3)
        return "Brought " .. target.Name
    end
    return "Player not found"
end

function Cmd.view(name)
    local cam = workspace.CurrentCamera
    name = trim(name)
    if name == "" or name:lower() == "off" then
        local h = getHum() if h then cam.CameraSubject = h end
        return "Camera back to you"
    end
    local plr = findPlayer(name)
    local h = plr and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if h then cam.CameraSubject = h return "Viewing " .. plr.Name end
    return "Player not found"
end

