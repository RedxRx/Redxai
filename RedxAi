    if clean:find("%[%[reset%]%]") then Cmd.reset() clean = clean:gsub("%[%[reset%]%]", "") end
    if clean:find("%[%[savepos%]%]") then Cmd.savepos() clean = clean:gsub("%[%[savepos%]%]", "") end
    if clean:find("%[%[loadpos%]%]") then Cmd.loadpos() clean = clean:gsub("%[%[loadpos%]%]", "") end
    if clean:find("%[%[fullbright%]%]") then Cmd.fullbright() clean = clean:gsub("%[%[fullbright%]%]", "") end
    if clean:find("%[%[esp:on%]%]") then Cmd.esp(true) clean = clean:gsub("%[%[esp:on%]%]", "") end
    if clean:find("%[%[esp:off%]%]") then Cmd.esp(false) clean = clean:gsub("%[%[esp:off%]%]", "") end
    if clean:find("%[%[btools%]%]") then Cmd.btools() clean = clean:gsub("%[%[btools%]%]", "") end
    if clean:find("%[%[serverhop%]%]") then Cmd.serverhop() clean = clean:gsub("%[%[serverhop%]%]", "") end
    local sp = clean:match("%[%[speed:(%d+)%]%]") if sp then Cmd.speed(tonumber(sp)) clean = clean:gsub("%[%[speed:%d+%]%]", "") end
    local jp = clean:match("%[%[jump:(%d+)%]%]") if jp then Cmd.jump(tonumber(jp)) clean = clean:gsub("%[%[jump:%d+%]%]", "") end
    local gv = clean:match("%[%[gravity:(%d+)%]%]") if gv then Cmd.gravity(tonumber(gv)) clean = clean:gsub("%[%[gravity:%d+%]%]", "") end
    local tp = clean:match("%[%[tp:([^%]]+)%]%]") if tp then Cmd.tp(tp) clean = clean:gsub("%[%[tp:[^%]]+%]%]", "") end
    local br = clean:match("%[%[bring:([^%]]+)%]%]") if br then Cmd.bring(br) clean = clean:gsub("%[%[bring:[^%]]+%]%]", "") end
    local kl = clean:match("%[%[kill:([^%]]+)%]%]") if kl then Cmd.kill(kl) clean = clean:gsub("%[%[kill:[^%]]+%]%]", "") end
    local fl = clean:match("%[%[fling:([^%]]+)%]%]") if fl then Cmd.fling(fl) clean = clean:gsub("%[%[fling:[^%]]+%]%]", "") end
    local fz = clean:match("%[%[freeze:([^%]]+)%]%]") if fz then Cmd.freeze(fz) clean = clean:gsub("%[%[freeze:[^%]]+%]%]", "") end
    local ch = clean:match("%[%[chat:([^%]]+)%]%]") if ch then Cmd.chat(ch) clean = clean:gsub("%[%[chat:[^%]]+%]%]", "") end
    return clean:match("^%s*(.-)%s*$")
end--[[ RedxAI v25 | Part 3 of 3 | UI & Direct Commands ]]

