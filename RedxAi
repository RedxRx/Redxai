local function getRoot() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end

local controlModule = nil
local controlTried = false
local function getMoveVector()
    if not controlModule and not controlTried then
        controlTried = true
        pcall(function()
            local ps = LP:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            local cm = pm and pm:FindFirstChild("ControlModule")
            if cm then controlModule = require(cm) end
        end)
    end
    if controlModule then
        local ok, v = pcall(function() return controlModule:GetMoveVector() end)
        if ok and typeof(v) == "Vector3" then return v end
    end
    local x, z = 0, 0
    if UIS:IsKeyDown(Enum.KeyCode.W) then z = z + 1 end
    if UIS:IsKeyDown(Enum.KeyCode.S) then z = z - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.A) then x = x - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.D) then x = x + 1 end
    return Vector3.new(x, 0, z)
end

local Cmd = {}

function Cmd.fly(on, speed)
    State.Fly = on
    if speed then State.FlySpeed = math.clamp(tonumber(speed), 1, 100000) end
    if not on then
        if FlyConn then FlyConn:Disconnect() FlyConn = nil end
        if FlyBV then FlyBV:Destroy() FlyBV = nil end
        if FlyBG then FlyBG:Destroy() FlyBG = nil end
        local h = getHum() if h then h.PlatformStand = false end
        return "🛑 Fly OFF"
    end
    local h, r = getHum(), getRoot()
    if not h or not r then return "❌ No character" end
    h.PlatformStand = true
    FlyBV = Instance.new("BodyVelocity") FlyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5) FlyBV.Parent = r
    FlyBG = Instance.new("BodyGyro") FlyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5) FlyBG.P = 1e4 FlyBG.Parent = r
    
    if FlyConn then FlyConn:Disconnect() end
    FlyConn = RS.RenderStepped:Connect(function()
        if not State.Fly or not r or not FlyBV then return end
        local cam = workspace.CurrentCamera
        local mv = getMoveVector()
        local fwd = cam.CFrame.LookVector
        local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
        if right.Magnitude > 0 then right = right.Unit end
        local dir = (fwd * -mv.Z) + (right * mv.X)
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        if dir.Magnitude > 1 then dir = dir.Unit end
        FlyBV.Velocity = dir * State.FlySpeed
        FlyBG.CFrame = CFrame.new(r.Position, r.Position + Vector3.new(fwd.X, 0, fwd.Z))
    end)
    return "✈ Fly ON (Speed: " .. State.FlySpeed .. ")"
end

function Cmd.speed(v) 
    State.Speed = math.clamp(tonumber(v) or 16, 1, 100000)
    local h = getHum() if h then h.WalkSpeed = State.Speed end 
    return "⚡ Speed: " .. State.Speed 
end

function Cmd.jump(v) 
    if v == "inf" or v == "infinite" then
        State.InfJump = true
        if InfJumpConn then InfJumpConn:Disconnect() end
        InfJumpConn = UIS.JumpRequest:Connect(function()
            local h = getHum() if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
        return "♾️ Infinite Jump ON"
    else
        State.InfJump = false
        if InfJumpConn then InfJumpConn:Disconnect() InfJumpConn = nil end
        State.Jump = math.clamp(tonumber(v) or 50, 1, 100000)
        local h = getHum() if h then h.UseJumpPower = true h.JumpPower = State.Jump end
        return "⬆ Jump: " .. State.Jump
    end
end

function Cmd.noclip(on)
    State.Noclip = on
    if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
    if on then
        NoclipConn = RS.Stepped:Connect(function()
            local c = LP.Character 
            if c then for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
        end)
        return "👻 Noclip ON"
    else
        local c = LP.Character 
        if c then for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = true end end end
        return "👻 Noclip OFF"
    end
end

function Cmd.god(on)
    State.God = on
    local h = getHum()
    if h then if on then h.MaxHealth = math.huge h.Health = math.huge else h.MaxHealth = 100 h.Health = 100 end end
    return on and "🛡️ God Mode ON" or "🛡️ God Mode OFF"
end

function Cmd.invisible(on)
    local c = LP.Character
    if c then for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") or p:IsA("Decal") then if on then p.LocalTransparencyModifier = 1 else p.LocalTransparencyModifier = 0 end end end end
    return on and "👤 Invisible ON" or "👤 Visible ON"
end

function Cmd.kill(name)
    local plr = Players:FindFirstChild(name)
    if plr and plr.Character then
        local h = plr.Character:FindFirstChild("Humanoid")
        if h then h.Health = 0 return "💀 Killed " .. name end
    end
    return "❌ Player not found"
end

function Cmd.fling(name)
    local plr = Players:FindFirstChild(name)
    if plr and plr.Character then
        local root = plr.Character:FindFirstChild("HumanoidRootPart")
        local h = plr.Character:FindFirstChild("Humanoid")
        if root and h then
            h.PlatformStand = true
            local bv = Instance.new("BodyVelocity", root)
            bv.Velocity = Vector3.new(500, 500, 500)
            bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            task.delay(2, function() bv:Destroy() end)
            return "🚀 Flung " .. name
        end
    end
    return "❌ Player not found"
end

function Cmd.freeze(name)
    local plr = Players:FindFirstChild(name)
    if plr and plr.Character then
        local root = plr.Character:FindFirstChild("HumanoidRootPart")
        local h = plr.Character:FindFirstChild("Humanoid")
        if root and h then
            h.PlatformStand = true
            local anchor = Instance.new("AnchorConstraint", root)
            return "❄️ Froze " .. name
        end
    end
    return "❌ Player not found"
end

