---------------------------------------------------------------- ACTIONS
local Actions = {}

local ControlModule
local function GetControls()
	if ControlModule ~= nil then return ControlModule or nil end
	ControlModule = false
	pcall(function()
		local ps = LP:FindFirstChild("PlayerScripts") or LP:WaitForChild("PlayerScripts", 3)
		local pm = ps and (ps:FindFirstChild("PlayerModule") or ps:WaitForChild("PlayerModule", 3))
		if pm then ControlModule = require(pm:WaitForChild("ControlModule", 3)) end
	end)
	return ControlModule or nil
end

-- returns (right, forward) in -1..1 — works with phone joystick AND keyboard
local function GetMove(hum, cam)
	local cm = GetControls()
	if cm then
		local ok, mv = pcall(function() return cm:GetMoveVector() end)
		if ok and typeof(mv) == "Vector3" then return mv.X, -mv.Z end
	end
	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then return 0, 0 end
	flat = flat.Unit
	local md = hum.MoveDirection
	return md:Dot(flat:Cross(Vector3.yAxis)), md:Dot(flat)
end

local flyConn, flyBV, flyBG

function Actions.StopFly()
	State.Fly = false
	FlyVert = 0
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local h = GetHum()
	if h then h.PlatformStand = false end
	RefreshUI()
end

function Actions.StartFly()
	local hum, root = GetHum(), GetRoot()
	if not hum or not root then return false end
	Actions.StopFly()
	State.Fly = true
	hum.PlatformStand = true
	flyBV = Instance.new("BodyVelocity")
	flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	flyBV.Velocity = Vector3.new(0, 0, 0)
	flyBV.Parent = root
	flyBG = Instance.new("BodyGyro")
	flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	flyBG.P = 1e4
	flyBG.D = 500
	flyBG.CFrame = root.CFrame
	flyBG.Parent = root
	flyConn = RunService.RenderStepped:Connect(function()
		local h, r, cam = GetHum(), GetRoot(), workspace.CurrentCamera
		if not State.Fly or not h or not r or not cam or not flyBV or flyBV.Parent ~= r then
			Actions.StopFly()
			return
		end
		h.PlatformStand = true
		local rx, fz = GetMove(h, cam)
		local cf = cam.CFrame
		local dir = cf.LookVector * fz + cf.RightVector * rx
		local v = FlyVert
		if UIS:IsKeyDown(Enum.KeyCode.Space) then v = v + 1 end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v = v - 1 end
		dir = dir + Vector3.new(0, v, 0)
		if dir.Magnitude > 1 then dir = dir.Unit end
		flyBV.Velocity = dir * State.FlySpeed
		local look = cf.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			flyBG.CFrame = CFrame.lookAt(r.Position, r.Position + flat)
		end
	end)
	RefreshUI()
	return true
end

function Actions.SetSpeed(v) -- nil = back to default
	State.Speed = v
	local h = GetHum()
	if h then h.WalkSpeed = v or 16 end
	RefreshUI()
end

function Actions.SetJump(v) -- nil = back to default
	State.Jump = v
	local h = GetHum()
	if h then
		h.UseJumpPower = true
		h.JumpPower = v or 50
	end
	RefreshUI()
end

local infConn
function Actions.SetInfJump(on)
	State.InfJump = on and true or false
	if infConn then infConn:Disconnect() infConn = nil end
	if State.InfJump then
		infConn = UIS.JumpRequest:Connect(function()
			local h = GetHum()
			if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
		end)
	end
	RefreshUI()
end

function Actions.ResetAll()
	Actions.StopFly()
	Actions.SetSpeed(nil)
	Actions.SetJump(nil)
	Actions.SetInfJump(false)
end

-- keep speed/jump alive even if the game tries to reset them
Track(RunService.Heartbeat:Connect(function()
	local h = GetHum()
	if not h then return end
	if State.Speed and h.WalkSpeed ~= State.Speed then h.WalkSpeed = State.Speed end
	if State.Jump then
		if not h.UseJumpPower then h.UseJumpPower = true end
		if h.JumpPower ~= State.Jump then h.JumpPower = State.Jump end
	end
end))
Track(LP.CharacterAdded:Connect(function()
	if State.Fly then Actions.StopFly() end
end))

