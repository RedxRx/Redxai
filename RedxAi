local function scrollDown() task.wait() chat.CanvasPosition = Vector2.new(0, chat.AbsoluteCanvasSize.Y) end
local function setBubbleText(bubble, s) if #s > 100000 then s = s:sub(1, 100000) .. "\n... (too long)" end bubble.Text = s end

local function addMsg(txt, isUser)
    local container = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = #chat:GetChildren() }, chat)
    new("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder}, container)
    local bubble = new("TextButton", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, BackgroundColor3 = isUser and Color3.fromRGB(90, 15, 25) or ModeInfo[State.Mode].bubble, TextColor3 = Color3.fromRGB(240, 220, 225), Font = Enum.Font.Code, TextSize = 13, TextWrapped = true, TextXAlignment = isUser and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left, AutoButtonColor = false, Text = "" }, container)
    corner(bubble, 6)
    new("UIPadding", {PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7)}, bubble)
    setBubbleText(bubble, txt)
    
    if not isUser and hasCode(txt) then
        local row = new("Frame", {Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 2}, container)
        local cb = new("TextButton", { Size = UDim2.fromOffset(120, 18), Position = UDim2.new(1, -120, 0, 1), BackgroundColor3 = Color3.fromRGB(20, 80, 50), Text = "📤", TextColor3 = Color3.fromRGB(180, 255, 200), Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = true }, row)
        corner(cb, 6)
        cb.MouseButton1Click:Connect(function()
            local code = extractCodeOnly(txt)
            if #code > 0 then
                local c = new("TextBox", {Size = UDim2.new(0.8, 0, 0.8, 0), Position = UDim2.new(0.1, 0, 0.1, 0), BackgroundColor3 = Color3.fromRGB(20,20,20), TextColor3 = Color3.fromRGB(150, 255, 150), Text = code, Font = Enum.Font.Code, TextWrapped = true, TextSize = 12, ZIndex = 100, ClearTextOnFocus = false}, gui)
                corner(c, 6)
            end
        end)
    end
    
    local copyRow = new("Frame", {Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = 3}, container)
    local copyBtn = new("TextButton", { Size = UDim2.fromOffset(40, 22), BackgroundColor3 = Color3.fromRGB(45, 12, 18), Text = "📋", TextColor3 = Color3.fromRGB(120, 210, 255), Font = Enum.Font.GothamBold, TextSize = 14 }, copyRow)
    corner(copyBtn, 6)
    copyBtn.MouseButton1Click:Connect(function()
        local clip = setclipboard or toclipboard or set_clipboard
        local ok = clip and pcall(clip, txt)
        copyBtn.Text = ok and "✅" or "⚠"
        task.wait(1.3)
        copyBtn.Text = "📋"
    end)
    
    scrollDown()
    return bubble, container
end

local function stripFences(s)
    local code = s:match("```[%w]*%s*\n(.-)```")
    if code then return trim(code) end
    local lines = {}
    for line in s:gmatch("[^\r\n]+") do lines[#lines + 1] = line end
    local startIdx = 1
    for i, line in ipairs(lines) do
        if line:match("^%s*local ") or line:match("^%s*--") or line:match("^%s*game:GetService") or line:match("^%s*getgenv") or line:match("^%s*loadstring") or line:match("^%s*workspace") or line:match("^%s*function ") then startIdx = i break end
    end
    return trim(table.concat(lines, "\n", startIdx))
end

local function Submit()
    if State.Busy then return end
    local txt = trim(input.Text)
    if txt == "" then return end
    input.Text = ""
    addMsg(txt, true)
    State.Busy = true
    task.spawn(function()
        local thinking, activeBubble = false, nil
        local ok, err = pcall(function()
            local nt = norm(txt)
            if nt == "/clear" or nt == "clear" then History = {{},{},{},{}; return end
            local mode = State.Mode
            if mode == 1 or mode == 4 then
                local direct = ParseDirectCommands(txt)
                if direct then addMsg(direct, false) return end
            end
            if mode == 4 then Maps._scan = nil end
            local bubble, container = addMsg("Thinking...", false)
            activeBubble = bubble
            thinking = true
            task.spawn(function() local n = 0 while thinking do n = n % 3 + 1 if bubble and bubble.Parent then bubble.Text = "Thinking" .. string.rep(".", n) end task.wait(0.4) end end)
            local ans, why = AskAI(txt, mode, false)
            if ans and (mode == 3 or mode == 4) and not looksLikeCode(stripFences(ans)) then ans = AskAI(txt, mode, true) or ans end
            thinking = false
            if not ans then setBubbleText(bubble, "Server busy. Try again.")
            else
                local clean = ans
                if mode == 3 or mode == 4 then clean = stripFences(ans); bubble.TextColor3 = Color3.fromRGB(150, 255, 150)
                elseif mode == 1 then clean = ApplyTags(ans) end
                if clean == "" then clean = "Done" end
                pushHist(mode, txt, ans)
                setBubbleText(bubble, clean)
            end
            scrollDown()
        end)
        thinking = false
        State.Busy = false
        if not ok and activeBubble and activeBubble.Parent then setBubbleText(activeBubble, "Error: " .. tostring(err)) end
    end)
end

send.MouseButton1Click:Connect(Submit)
input.FocusLost:Connect(function(enter) if enter then Submit() end end)

local dragging, dragStart, startPos = false, nil, nil
bar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = i.Position
        startPos = main.Position
    end
end)
UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)

