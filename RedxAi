---------------------------------------------------------------- SEND
local Busy = false
local function Submit()
	if Busy then return end
	local text = (input.Text or ""):match("^%s*(.-)%s*$")
	if text == "" then return end
	input.Text = ""
	AddMessage(text, "user")
	Busy = true
	task.spawn(function()
		local ok, err = pcall(function()
			local ar = HasArabic(text)
			local handled, reply = TryCommand(text, ar)
			if handled then
				AddMessage(reply, "bot")
				return
			end
			local bubble = AddMessage("• • •", "bot")
			local ans = AskAI(text)
			if ans then
				ans = ans:gsub("%*%*", "")
				local clean, did = ApplyTags(ans)
				if clean == "" then clean = did and T(ar, "تمام ✅", "Done ✅") or "..." end
				SetBubble(bubble, clean)
				History[#History + 1] = { role = "user", content = text }
				History[#History + 1] = { role = "assistant", content = clean }
				while #History > CONFIG.MaxHistory do table.remove(History, 1) end
			else
				SetBubble(bubble, KBAnswer(text, ar) or T(ar,
					"مقدرتش أوصل للذكاء الاصطناعي دلوقتي (النت أو الخدمة مشغولة). جرب كمان شوية، أو اكتب أمر زي: طيران / سرعة 100.",
					"I couldn't reach the AI right now (internet or the free service is busy). Try again in a moment, or use a command like: fly / speed 100."))
			end
		end)
		if not ok then AddMessage("⚠ " .. tostring(err), "bot") end
		Busy = false
	end)
end
Track(sendBtn.Activated:Connect(Submit))
Track(input.FocusLost:Connect(function(enter) if enter then Submit() end end))

