---------------------------------------------------------------- TEXT ENGINE (Arabic + English)
local function T(ar, a, e) if ar then return a end return e end
local function HasArabic(s) return s:find("[\216-\219]") ~= nil end

-- normalize: lowercase, Arabic digits -> 0-9, alef/ya/ta-marbuta variants, remove tashkeel
local function Norm(s)
	s = tostring(s or "")
	local ok, out = pcall(function()
		local t = {}
		for _, cp in utf8.codes(s) do
			if (cp >= 0x064B and cp <= 0x0652) or cp == 0x0640 or cp == 0x0670 then
				-- skip diacritics / tatweel
			elseif cp == 0x0623 or cp == 0x0625 or cp == 0x0622 or cp == 0x0671 then t[#t + 1] = utf8.char(0x0627)
			elseif cp == 0x0629 then t[#t + 1] = utf8.char(0x0647)
			elseif cp == 0x0649 or cp == 0x0626 then t[#t + 1] = utf8.char(0x064A)
			elseif cp == 0x0624 then t[#t + 1] = utf8.char(0x0648)
			elseif cp >= 0x0660 and cp <= 0x0669 then t[#t + 1] = utf8.char(48 + cp - 0x0660)
			elseif cp >= 0x06F0 and cp <= 0x06F9 then t[#t + 1] = utf8.char(48 + cp - 0x06F0)
			elseif cp >= 65 and cp <= 90 then t[#t + 1] = utf8.char(cp + 32)
			else t[#t + 1] = utf8.char(cp) end
		end
		return table.concat(t)
	end)
	if ok then return out end
	return string.lower(s)
end

local function Clean(s)
	local n = Norm(s)
	n = n:gsub("[^%w\128-\255]+", " ")
	n = n:gsub("%s+", " ")
	return (n:match("^%s*(.-)%s*$"))
end

local function IsAscii(s) return not s:find("[\128-\255]") end
local function HasExact(n, kw) return (" " .. n .. " "):find(" " .. kw .. " ", 1, true) ~= nil end
local function Has(n, kw)
	if kw == "" then return false end
	if IsAscii(kw) then
		if #kw <= 3 then return HasExact(n, kw) end
		return (" " .. n):find(" " .. kw, 1, true) ~= nil
	end
	if #kw <= 4 then return HasExact(n, kw) end
	return n:find(kw, 1, true) ~= nil
end
local function HasAny(n, list)
	for _, kw in ipairs(list) do if Has(n, kw) then return true end end
	return false
end
local function KW(list)
	local o = {}
	for i, k in ipairs(list) do o[i] = Clean(k) end
	return o
end

