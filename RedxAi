local function onoff(a)
    a = tostring(a or ""):lower()
    return not (a == "off" or a == "false" or a == "0" or a == "no")
end

local Tags = {
    fly = function(a) if a:lower() == "off" then return Cmd.fly(false) end return Cmd.fly(true, tonumber(a)) end,
    speed = function(a) if tonumber(a) then return Cmd.speed(tonumber(a)) end return Cmd.speedoff() end,
    jump = function(a)
        a = a:lower()
        if a == "inf" then return Cmd.jump("inf") end
        if tonumber(a) then return Cmd.jump(tonumber(a)) end
        return Cmd.jumpoff()
    end,
    noclip = function(a) return Cmd.noclip(onoff(a)) end,
    god = function(a) return Cmd.god(onoff(a)) end,
    invisible = function(a) return Cmd.invisible(onoff(a)) end,
    esp = function(a) return Cmd.esp(onoff(a)) end,
    spin = function(a) return Cmd.spin(onoff(a), tonumber(a)) end,
    clicktp = function(a) return Cmd.clicktp(onoff(a)) end,
    antiafk = function(a) return Cmd.antiafk(onoff(a)) end,
    fullbright = function(a) return Cmd.fullbright(onoff(a)) end,
    gravity = function(a) return Cmd.gravity(tonumber(a)) end,
    day = function() return Cmd.day() end,
    night = function() return Cmd.night() end,
    sit = function() return Cmd.sit() end,
    reset = function() return Cmd.reset() end,
    tp = function(a) return Cmd.tp(a) end,
    bring = function(a) return Cmd.bring(a) end,
    kill = function(a) return Cmd.kill(a) end,
