local function ParseDirectCommands(txt)
    if State.Mode ~= 1 then return nil end
    local t = string.lower(txt) local num = tonumber(t:match("%d+"))
    if t:match("طيران") or t:match("فلاي") or t:match("fly") then return Cmd.fly(true, num) end
    if t:match("وقف الطيران") or t:match("unfly") then return Cmd.fly(false) end
    if t:match("سرعة") or t:match("سبيد") or t:match("speed") or t:match("ws") then return Cmd.speed(num or 100) end
    if t:match("قفز لا نهائي") or t:match("infinite jump") or t:match("infjump") then return Cmd.jump("inf") end
    if t:match("قفز") or t:match("جمب") or t:match("jump") or t:match("jp") then return Cmd.jump(num or 150) end
    if t:match("نوكليب") or t:match("noclip") then return Cmd.noclip(not State.Noclip) end
    if t:match("جود") or t:match("god") then return Cmd.god(not State.God) end
    if t:match("انفزنال") or t:match("invisible") then return Cmd.invisible(true) end
    if t:match("فول برايت") or t:match("fullbright") then return Cmd.fullbright() end
    if t:match("اس بي") or t:match("esp") then return Cmd.esp(not State.ESP) end
    if t:match("ادوات") or t:match("btools") then return Cmd.btools() end
    if t:match("سيرفر") or t:match("serverhop") then return Cmd.serverhop() end
    if t:match("جاذبية") or t:match("gravity") then return Cmd.gravity(num or 196.2) end
    if t:match("اقعد") or t:match("sit") then return Cmd.sit() end
    if t:match("ريسيت") or t:match("reset") then return Cmd.reset() end
    if t:match("احفظ") or t:match("savepos") then return Cmd.savepos() end
    if t:match("ارجع") or t:match("loadpos") then return Cmd.loadpos() end
    if t:match("اقتل") or t:match("kill") then local name = t:match("اقتل%s+(.+)") or t:match("kill%s+(.+)") if name then return Cmd.kill(name) end end
    if t:match("هات") or t:match("جيب") or t:match("bring") then local name = t:match("هات%s+(.+)") or t:match("جيب%s+(.+)") or t:match("bring%s+(.+)") if name then return Cmd.bring(name) end end
    if t:match("روح ل") or t:match("tp ") or t:match("goto ") then local name = t:match("روح ل%s+(.+)") or t:match("tp%s+(.+)") or t:match("goto%s+(.+)") if name then return Cmd.tp(name) end end
    return nil
end

local function Submit()
    if State.Busy then return end
    local txt = input.Text:match("^%s*(.-)%s*$") if txt == "" then return end
    input.Text = "" addMsg(txt, true) State.Busy = true
    
    task.spawn(function()
        local directReply = ParseDirectCommands(txt)
        if directReply then addMsg(directReply, false) State.Busy = false return end
        
        local bubble = addMsg("🤔 جاري التفكير...", false)
        local thinking = true local dots = {".", "..", "...", "...."} local dotIndex = 1
        task.spawn(function() while thinking do bubble.Text = "  🤔 جاري التفكير" .. dots[dotIndex] .. "  " dotIndex = dotIndex % #dots + 1 task.wait(0.4) end end)

        local ans = AskAI(txt) thinking = false
        
        if ans then
            local clean = ans
            if State.Mode == 3 then
                clean = clean:gsub("```lua", ""):gsub("```", ""):match("^%s*(.-)%s*$")
                bubble.TextColor3 = Color3.fromRGB(150, 255, 150)
            else
                clean = ApplyTags(clean)
            end
            if clean == "" then clean = "✅ Done" end
            bubble.Text = "  " .. clean .. "  "
        else bubble.Text = "  ⚠ Server busy.  " end
        task.wait() chat.CanvasPosition = Vector2.new(0, chat.AbsoluteCanvasSize.Y)
        State.Busy = false
    end)
end

