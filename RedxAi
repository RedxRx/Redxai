local function Submit()
    if State.Busy then return end
    local txt = trim(input.Text) if txt == "" then return end
    input.Text = "" addMsg(txt, true) State.Busy = true
    task.spawn(function()
        local ok, err = pcall(function()
            local nt = norm(txt)
            if nt == "/clear" or nt == "clear" then History[1], History[2], History[3] = {}, {}, {} addMsg("🧹 مسحت ذاكرة المحادثة.", false) return end
            local mode = State.Mode
            if mode == 1 then local direct = ParseDirectCommands(txt) if direct then addMsg(direct, false) return end end
            local bubble, container = addMsg("🤔 جاري التفكير...", false)
            local thinking = true
            task.spawn(function() local n = 0 while thinking do n = n % 3 + 1 bubble.Text = "🤔 جاري التفكير" .. string.rep(".", n) task.wait(0.4) end end)
            local ans, why = AskAI(txt, mode, false)
            if ans and mode == 3 and not looksLikeCode(stripFences(ans)) then ans = AskAI(txt, mode, true) or ans end
            thinking = false
            if not ans then
                if why == "no_http" then setBubbleText(bubble, "⚠ الإكسيكيوتر بتاعك مش بيدعم الاتصال بالإنترنت (request).")
                else setBubbleText(bubble, "⚠ السيرفر مشغول أو النت ضعيف، جرب تاني بعد ثواني.") end
            else
                local clean = ans
                if mode == 3 then clean = stripFences(ans) bubble.TextColor3 = Color3.fromRGB(150, 255, 150)
                elseif mode == 1 then clean = ApplyTags(ans) end
                if clean == "" then clean = "✅ تم" end
                pushHist(mode, txt, ans) setBubbleText(bubble, clean) attachCopy(container, clean)
            end
            scrollDown()
        end)
        State.Busy = false
        if not ok then addMsg("⚠ حصل خطأ: " .. tostring(err), false) end
    end)
end

