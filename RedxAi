local function stripFences(s)
    local code = s:match("```[%w]*%s*\n(.-)```")
    if code then return trim(code) end
    local lines = {}
    for line in s:gmatch("[^\r\n]+") do lines[#lines + 1] = line end
    local startIdx = 1
    for i, line in ipairs(lines) do
        if line:match("^%s*local ") or line:match("^%s*--") or line:match("^%s*game:GetService") or line:match("^%s*getgenv") or line:match("^%s*loadstring") or line:match("^%s*workspace") or line:match("^%s*function ") then 
            startIdx = i 
            break 
        end
    end
    return trim(table.concat(lines, "\n", startIdx))
end

-- ═══ Submit Logic ═══
local function Submit()
    if State.Busy then return end
    local txt = trim(input.Text) 
    if txt == "" then return end
    
    input.Text = "" 
    addMsg(txt, true) 
    State.Busy = true
    
    task.spawn(function()
        local thinking, activeBubble = false, nil
        local ok, err = pcall(function()
            local nt = norm(txt)
            if nt == "/clear" or nt == "clear" then 
                History = {{},{},{},{}} 
                return 
            end
            
            local mode = State.Mode
            if mode == 1 or mode == 4 then 
                local direct = ParseDirectCommands(txt) 
                if direct then 
                    addMsg(direct, false) 
                    return 
                end 
            end
            
            if mode == 4 then Maps._scan = nil end
            
            local bubble, container = addMsg("Thinking...", false)
            activeBubble = bubble
            thinking = true
            
            task.spawn(function() 
                local n = 0 
                while thinking do 
                    n = n % 3 + 1 
                    if bubble and bubble.Parent then 
                        bubble.Text = "Thinking" .. string.rep(".", n) 
                    end 
                    task.wait(0.4) 
                end 
            end)
            
            local ans, why = AskAI(txt, mode, false)
            if ans and (mode == 3 or mode == 4) and not looksLikeCode(stripFences(ans)) then 
                ans = AskAI(txt, mode, true) or ans 
            end
            thinking = false
            
            if not ans then 
                setBubbleText(bubble, "Server busy. Try again.") 
            else
                local clean = ans
                if mode == 3 or mode == 4 then 
                    clean = stripFences(ans) 
                    bubble.TextColor3 = Color3.fromRGB(150, 255, 150) 
                elseif mode == 1 then 
                    clean = ApplyTags(ans) 
                end
                if clean == "" then clean = "Done" end
                pushHist(mode, txt, ans)
                setBubbleText(bubble, clean)
            end
            scrollDown()
        end)
        
        thinking = false
        State.Busy = false
        if not ok and activeBubble and activeBubble.Parent then 
            setBubbleText(activeBubble, "Error: " .. tostring(err)) 
        end
    end)
end

