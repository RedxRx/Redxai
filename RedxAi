local function BuildSystem(mode, text)
    local L = langHint(text)
    if mode == 4 then return Maps.System(L) end
    if mode == 3 then
        return "You are RedxAI Scripter.\n"
            .. "1. Write IMMEDIATELY. Never ask.\n"
            .. "2. Output ONLY raw Lua code. No fences. No text. Start directly with 'local' or 'game'.\n"
            .. "CRITICAL: Do NOT write any introductory or concluding text. Just the code.\n"
            .. "3. Comments in " .. L .. "."
    elseif mode == 2 then
        return "You are RedxAI CodeMaster.\nExplain clearly. Code inside lua blocks.\nReply in " .. L .. "."
    end
    return "You are RedxAI, a brilliant AI assistant inside a Roblox executor.\n"
        .. "If script requested, write it in lua block. Reply in " .. L .. ".\n"
        .. "GAME ACTIONS: write a short reply + matching tags at VERY END. Tags: " .. TAGLIST
end

local function pushHist(mode, q, a)
    local h = History[mode] or {}
    History[mode] = h
    h[#h + 1] = {role = "user", content = q}
    h[#h + 1] = {role = "assistant", content = a:sub(1, 2500)}
    while #h > MAX_HIST do table.remove(h, 1) end
end

local function AskAI(text, mode, force)
    local req = getReq()
    if not req then return nil, "no_http" end
    local msgs = {{role = "system", content = BuildSystem(mode, text)}}
    for _, m in ipairs(History[mode] or {}) do msgs[#msgs + 1] = m end
    local L = langHint(text)
    local u
    if mode == 4 then
        local scan = Maps.Scan()
        u = "MAP SCAN (live):\n" .. scan .. "\n\nUSER REQUEST: " .. text .. "\n\nOutput ONLY raw Lua, no fences. Comments in " .. L .. "."
        if force then u = u .. "\n\nIMPORTANT: output ONLY raw Lua code. Do not refuse." end
    elseif mode == 3 then
        u = "Write complete Roblox Lua script. Comments in " .. L .. ".\nRequest: " .. text
        if force then u = u .. "\n\nIMPORTANT: output ONLY raw Lua. Do not refuse." end
    else
        u = text .. "\n\n(Reply language: " .. L .. ")"
    end
    msgs[#msgs + 1] = {role = "user", content = u}
    for _, model in ipairs({"openai", "mistral"}) do
        local ok, body = pcall(function() return HS:JSONEncode({model = model, messages = msgs}) end)
        if ok then
            local ok1, res = pcall(req, {Url = "https://text.pollinations.ai/openai", Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
            if ok1 and res and res.Body then
                local ok2, data = pcall(function() return HS:JSONDecode(res.Body) end)
                if ok2 and type(data) == "table" and data.choices and data.choices[1] and data.choices[1].message then
                    local c = data.choices[1].message.content
                    if type(c) == "string" and c ~= "" then return c end
                end
            end
        end
    end
    return nil, "server"
end

